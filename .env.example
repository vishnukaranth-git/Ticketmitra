# TicketMitra Environment Configuration for Vercel & Production

# Django Core
SECRET_KEY=your-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database (Optional for Vercel: Highly recommended to use a free PostgreSQL from Neon.tech or Supabase)
